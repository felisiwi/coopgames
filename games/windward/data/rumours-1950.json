{
  "_about": "Rumour records for 1950 (data only). A rumour POINTS AT a thing or a place, is TOLD through a 1950 channel (a person you hail, the evening shipping forecast on the radio, a harbour notice board, the post), lasts some days, and is TRUE or a TWIST (with what is actually so). Mostly true, sometimes a twist, never empty (ALIVE-SEA mini-quest grill round 3, item 16).",
  "_spec": "games/windward/docs/ALIVE-SEA.md: \"Grill: generated mini quests\" (rounds 1 to 3), \"the thing model\" (rumours, regulars, warmth), \"anchoring\", \"day and night\". Ids link to data/things-1950.json (things), artifacts-1950.json, quests-1950.json, rumours-1950.json and data/island-lore.json.",
  "_invented": "Everything here is INVENTED unless a record says otherwise: each carries invented:true and a source {kind, refs}. Spoken lines are INVENTED-DIALOGUE, short, for Felix to rewrite by eye. No real private person is named.",
  "_fields": {
    "id": "rumour.<slug>",
    "channel": "person | radio | notice-board | post",
    "target": "{ thing?: thing id, place?: name-list or island-lore id }: at least one",
    "tellers": "[{ thing: id } | { channel: radio, program, at: place id, venue: keeper | shop-or-cafe, via?: thing id, note? } | { channel: notice-board | post, at: place id, note? }]. A radio rumour lists every place it can be heard: the Måseskär keeper's battery radio (venue keeper, via the keeper) and a shop or café radio in each harbour",
    "text": "what is said (never empty)",
    "days": "how many game days it keeps going round",
    "truth": "true | twist",
    "twist": "for a twist: what is actually so",
    "dynamic": "\"weather\": truth follows the weather system (radio forecasts)",
    "when": "optional conditions, same vocabulary as things-1950.json",
    "source": "{ kind, refs[], note? }",
    "invented": "always true",
    "lore": "{ place, hook: rumours, index } into island-lore.json"
  },
  "_vocab": {
    "channels": [
      "person",
      "radio",
      "notice-board",
      "post"
    ],
    "truth": [
      "true",
      "twist"
    ],
    "radioVenues": [
      "keeper",
      "shop-or-cafe"
    ]
  },
  "_counts": {
    "total": 53,
    "byChannel": {
      "person": 44,
      "radio": 3,
      "notice-board": 3,
      "post": 3
    },
    "byTruth": {
      "true": 37,
      "twist": 16
    },
    "fromLore": 26
  },
